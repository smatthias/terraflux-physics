{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.example/schemas/weather/coupled-wind-run-v1.json",
  "title": "TerraFlux coupled wind / moist-layer run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "time",
    "grid",
    "atmosphere",
    "diffusion",
    "pressure",
    "initial_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "terraflux.weather.coupled-wind-run/v1"
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_time_utc",
        "timestep_seconds",
        "steps"
      ],
      "properties": {
        "start_time_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "timestep_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Must satisfy timestep * (max |f| + k) <= 1 for the configured atmosphere."
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nx",
        "ny",
        "origin_east_m",
        "origin_north_m",
        "spacing_east_m",
        "spacing_north_m",
        "geographic_anchor_longitude_deg",
        "geographic_anchor_latitude_deg"
      ],
      "properties": {
        "nx": {
          "type": "integer",
          "minimum": 2
        },
        "ny": {
          "type": "integer",
          "minimum": 2
        },
        "origin_east_m": {
          "type": "number"
        },
        "origin_north_m": {
          "type": "number"
        },
        "spacing_east_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spacing_north_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geographic_anchor_longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "geographic_anchor_latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "description": "Latitude used for f_plane and beta_plane Coriolis modes; the anchor is local (0, 0)."
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "air_density_kg_m3",
        "surface_friction_coefficient_s",
        "coriolis_mode"
      ],
      "properties": {
        "air_density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "surface_friction_coefficient_s": {
          "type": "number",
          "minimum": 0,
          "description": "Linear (Rayleigh) drag coefficient k in 1/s. Zero gives a frictionless, purely geostrophic steady state."
        },
        "coriolis_mode": {
          "enum": [
            "none",
            "f_plane",
            "beta_plane",
            "prescribed"
          ]
        },
        "coriolis_parameter_s": {
          "type": "number",
          "description": "Required when coriolis_mode is prescribed; ignored otherwise."
        },
        "earth_angular_speed_rad_s": {
          "type": "number",
          "minimum": 0,
          "default": 7.2921159e-05
        },
        "earth_radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 6371000
        }
      },
      "if": {
        "properties": {
          "coriolis_mode": {
            "const": "prescribed"
          }
        }
      },
      "then": {
        "required": [
          "coriolis_parameter_s"
        ]
      }
    },
    "diffusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_m2_s",
        "humidity_m2_s",
        "momentum_m2_s"
      ],
      "properties": {
        "temperature_m2_s": {
          "type": "number",
          "minimum": 0
        },
        "humidity_m2_s": {
          "type": "number",
          "minimum": 0
        },
        "momentum_m2_s": {
          "type": "number",
          "minimum": 0,
          "description": "Must satisfy 2 nu dt (1/dx^2 + 1/dy^2) <= 1."
        }
      },
      "description": "Horizontal mixing diffusivities between the pressure systems; additional to the implicit numerical diffusion of first-order upwind transport."
    },
    "pressure_gradient_boundary": {
      "enum": [
        "one_sided",
        "periodic"
      ],
      "default": "one_sided"
    },
    "scalar_boundary": {
      "enum": [
        "zero_gradient",
        "periodic"
      ],
      "default": "zero_gradient"
    },
    "density_mode": {
      "enum": [
        "diagnosed",
        "constant"
      ],
      "default": "diagnosed",
      "description": "diagnosed: rho = p / (R_d T (1 + 0.608 q)) each step; constant: atmosphere.air_density_kg_m3."
    },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "pressure_pa"
          ]
        },
        {
          "required": [
            "pressure_systems"
          ]
        }
      ],
      "properties": {
        "pressure_pa": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "Row-major nx * ny cell-center pressures in pascals."
        },
        "pressure_systems": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background_pressure_pa",
            "centers"
          ],
          "properties": {
            "background_pressure_pa": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "centers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "east_m",
                  "north_m",
                  "pressure_anomaly_pa",
                  "radius_m"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "high",
                      "low"
                    ]
                  },
                  "east_m": {
                    "type": "number"
                  },
                  "north_m": {
                    "type": "number"
                  },
                  "pressure_anomaly_pa": {
                    "type": "number",
                    "description": "Positive for high, negative for low. Added as anomaly * exp(-(r / radius_m)^2)."
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "initial_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "air_temperature_k",
        "specific_humidity_kg_kg"
      ],
      "properties": {
        "air_temperature_k": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "background"
              ]
            }
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "background": {
              "type": "number"
            },
            "anomalies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "east_m",
                  "north_m",
                  "radius_m",
                  "amplitude"
                ],
                "properties": {
                  "east_m": {
                    "type": "number"
                  },
                  "north_m": {
                    "type": "number"
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "amplitude": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "description": "Kelvin; per-cell values or background + Gaussian anomalies. Must stay above 0 K."
        },
        "specific_humidity_kg_kg": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "background"
              ]
            }
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "background": {
              "type": "number"
            },
            "anomalies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "east_m",
                  "north_m",
                  "radius_m",
                  "amplitude"
                ],
                "properties": {
                  "east_m": {
                    "type": "number"
                  },
                  "north_m": {
                    "type": "number"
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "amplitude": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "description": "kg/kg; per-cell values or background + Gaussian anomalies. Must stay within [0, 1)."
        }
      }
    },
    "initial_wind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_seconds",
        "wind_east_m_s",
        "wind_north_m_s"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "wind_east_m_s": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "wind_north_m_s": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "description": "Optional; the run starts from rest at elapsed 0 when omitted."
    },
    "snapshot_every_steps": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional; emit a wind snapshot after every N steps. Must not exceed steps."
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_count",
        "layer_thickness_m",
        "environment_lapse_rate_k_m",
        "humidity_scale_height_m"
      ],
      "properties": {
        "layer_count": {
          "type": "integer",
          "minimum": 2
        },
        "layer_thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "environment_lapse_rate_k_m": {
          "type": "number",
          "minimum": -0.05,
          "maximum": 0.05,
          "description": "Environment T(z) = T_surface - lapse * min(z, tropopause); positive values cool with height."
        },
        "tropopause_height_m": {
          "type": "number",
          "minimum": 0,
          "default": 11000
        },
        "humidity_scale_height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "q(z) = q_surface exp(-z / scale height)."
        },
        "parcel_step_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 50,
          "description": "Vertical step of the parcel ascent; at most the layer thickness."
        }
      },
      "description": "Vertical layers above each cell: hydrostatic profile from the cell's surface pressure, temperature and humidity, convective adjustment, and a lifted surface parcel."
    },
    "cloud_formation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontal_gradient_threshold_k_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "|grad T| at or above this marks a frontal zone (K/m; 2e-5 = 2 K per 100 km)."
        },
        "advection_threshold_k_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "|\u2212V\u00b7grad T| above this classifies cold (negative) or warm (positive) fronts; otherwise stationary."
        },
        "boundary_layer_depth_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "H in the convergence lifting w = \u2212H div V; also the base of the thermal mixed layer."
        },
        "lifting_time_scale_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Lifting depth = w \u00d7 time scale."
        },
        "mixed_layer_growth_m_per_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Mixed-layer top reached by thermals = H + growth \u00d7 surface heating."
        },
        "warm_front_slope": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Rise per horizontal distance of the warm-front surface (e.g. 1/200)."
        },
        "cold_front_slope": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Rise per horizontal distance of the cold-front surface (e.g. 1/75); must be at least the warm slope."
        },
        "warm_front_reach_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Horizontal reach of overrunning cloud on the cold side of a warm front."
        },
        "cold_front_reach_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Horizontal reach of overrunning cloud behind a cold front."
        },
        "frontal_band_width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Warm-side distance within which lifting counts as frontal."
        },
        "cin_trigger_j_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Convection is released freely when the heated parcel's CIN is at or below this."
        },
        "cape_threshold_j_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum CAPE for convective cloud."
        },
        "max_cloud_top_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Cloud tops are capped here."
        },
        "surface_heating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amplitude_k"
          ],
          "properties": {
            "amplitude_k": {
              "type": "number",
              "minimum": 0,
              "description": "Diurnal surface heating amplitude applied to the lifted surface parcel: heating(t) = amplitude \u00d7 max(0, sin(2\u03c0 (t \u2212 phase) / 86400))."
            },
            "phase_seconds": {
              "type": "number",
              "default": 0,
              "description": "Elapsed time at which heating starts rising (sunrise); negative values start before the run."
            }
          }
        }
      },
      "description": "Cloud formation diagnostics (fronts + convection). Requires the column section. Every value is optional and defaults to the documented rule-of-thumb constants."
    },
    "precipitation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stratiform_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Fraction of condensate from layered lifting that reaches the ground."
        },
        "convective_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Fraction of condensate from convective updrafts that reaches the ground."
        },
        "convective_updraft_fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Area fraction of a cell occupied by convective updrafts (cell-mean rate = fraction \u00d7 updraft rate)."
        },
        "updraft_parcel_factor": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Updraft = factor \u00d7 sqrt(2 CAPE); parcel theory overestimates real updrafts by about 2."
        },
        "interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Interval over which accumulation = rate \u00d7 duration fraction \u00d7 interval is estimated; defaults to the snapshot interval."
        },
        "snow_wet_bulb_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Surface wet-bulb temperature at or below which precipitation is snow (default 0.5 \u00b0C)."
        },
        "sleet_wet_bulb_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Surface wet-bulb temperature up to which precipitation is mixed sleet (default 2 \u00b0C); liquid above."
        },
        "lightning_top_temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Cumulonimbus tops at or below this temperature (default \u221220 \u00b0C) carry lightning when the cloud crosses the freezing level."
        },
        "hail_min_diameter_cm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Smallest hail reported after melting."
        },
        "hail_melting_cm_per_km": {
          "type": "number",
          "minimum": 0,
          "description": "Diameter lost per kilometre of fall below the freezing level."
        },
        "hail_max_diameter_cm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Cap on the reported hail size."
        },
        "drizzle_max_rate_mm_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Rate cap for stratus drizzle and stratocumulus."
        },
        "virga_surface_rh": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Light precipitation into air drier than this (fraction) from a base above virga_min_base_m evaporates (virga)."
        },
        "virga_max_rate_mm_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Largest rate that can evaporate completely as virga."
        },
        "virga_min_base_m": {
          "type": "number",
          "minimum": 0,
          "description": "Lowest cloud base for virga."
        },
        "minimum_rate_mm_h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Rates below this are reported as no precipitation."
        }
      },
      "description": "Precipitation outcomes of the diagnosed clouds. Requires cloud_formation. Every value is optional; interval_seconds defaults to the snapshot interval."
    }
  }
}
