{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.example/schemas/solar-cycle-run-v1.schema.json",
  "title": "TerraFlux solar cycle run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record",
    "forecast",
    "uv_sites",
    "disk"
  ],
  "properties": {
    "schema_version": {
      "const": "terraflux.solar.cycle-run/v1"
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cycle_table"
            },
            "data_origin": {
              "type": "string",
              "minLength": 1,
              "description": "Where the table comes from; copied into the output."
            },
            "first_cycle_number": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000,
              "description": "Number of the cycle that starts at the first minimum detected in the synthesised record; must be in the table."
            },
            "start_year": {
              "type": "number",
              "minimum": 1600,
              "description": "First month of the synthesised record; it should lie in the decline of the table's first cycle."
            },
            "calibrate_widths": {
              "type": "boolean",
              "default": false,
              "description": "Scale each cycle's width until its maximum falls on maximum_year (off: single smooth curves cannot represent double peaks)."
            },
            "first_lead_years": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "default": 0.3,
              "description": "Onset of the first table cycle before its minimum (it has no predecessor to calibrate against)."
            },
            "noise": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "factor": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 2.5,
                  "description": "f in R_m = R + f sqrt(R + 1) e_m"
                },
                "autocorrelation": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.999,
                  "default": 0.6,
                  "description": "Lag-1 correlation of e_m"
                },
                "seed": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "cycles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 1000,
                    "description": "Consecutive cycle numbers."
                  },
                  "minimum_year": {
                    "type": "number",
                    "description": "Decimal year of the minimum of the 13-month smoothed sunspot number that starts the cycle."
                  },
                  "maximum_year": {
                    "type": "number",
                    "description": "Decimal year of the maximum (used only with calibrate_widths, otherwise reported for comparison)."
                  },
                  "maximum": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 600,
                    "description": "Maximum of the 13-month smoothed sunspot number (v2)."
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "minimum_year",
                  "maximum"
                ]
              },
              "minItems": 5,
              "maxItems": 60
            }
          },
          "required": [
            "kind",
            "start_year",
            "cycles",
            "first_cycle_number"
          ],
          "description": "A table of cycles turned into overlapping Hathaway curves (calibrated to the table's minima and maxima) and a monthly record with correlated noise."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "monthly"
            },
            "data_origin": {
              "type": "string",
              "minLength": 1
            },
            "first_cycle_number": {
              "type": "integer",
              "minimum": -100,
              "maximum": 1000
            },
            "first_year": {
              "type": "integer",
              "minimum": 1600,
              "maximum": 3000
            },
            "first_month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "minItems": 480,
              "maxItems": 7200,
              "description": "Monthly mean sunspot numbers (v2) without gaps; tools/silso_to_request.py converts the SILSO file."
            }
          },
          "required": [
            "kind",
            "first_year",
            "values",
            "first_cycle_number"
          ]
        }
      ]
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue_year": {
          "type": "number",
          "description": "The forecast uses the record before this date (the record ends here)."
        },
        "horizon_year": {
          "type": "number",
          "description": "2-40 years after the issue year."
        },
        "members": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2000,
          "default": 200
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "backtest_phases_years": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "minItems": 1,
          "maxItems": 20,
          "description": "Years after each past minimum at which the backtest issues forecasts (increasing)."
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "half_window_months": {
              "type": "integer",
              "minimum": 6,
              "maximum": 60,
              "default": 30
            },
            "confirm_months": {
              "type": "integer",
              "minimum": 3,
              "maximum": 60,
              "default": 12
            },
            "minimum_history_cycles": {
              "type": "integer",
              "minimum": 2,
              "maximum": 30,
              "default": 3
            },
            "fit_lead_in_years": {
              "type": "number",
              "minimum": 0,
              "maximum": 3,
              "default": 1.0
            },
            "shape_fit_phase_years": {
              "type": "number",
              "minimum": 1,
              "maximum": 12,
              "default": 5.5
            },
            "onset_search_years": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "default": 2.0
            }
          }
        }
      },
      "required": [
        "issue_year",
        "horizon_year"
      ]
    },
    "irradiance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "f107_base_sfu": {
          "type": "number",
          "minimum": 30,
          "maximum": 120,
          "default": 65
        },
        "f107_per_sunspot": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3,
          "default": 0.62
        },
        "f107_per_sunspot_squared": {
          "type": "number",
          "minimum": -0.01,
          "maximum": 0.01,
          "default": 0
        },
        "mgii_quiet": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.2,
          "default": 0.15
        },
        "mgii_per_sfu": {
          "type": "number",
          "minimum": 1e-07,
          "maximum": 0.001,
          "default": 0.00011
        },
        "reference_sunspot_number": {
          "type": "number",
          "minimum": 50,
          "maximum": 400,
          "default": 180
        },
        "tsi_quiet_w_m2": {
          "type": "number",
          "minimum": 1350,
          "maximum": 1370,
          "default": 1360.6
        },
        "facular_brightening_w_m2": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 2.1
        },
        "spot_darkening_w_m2_per_sunspot": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05,
          "default": 0.0055
        },
        "uv_bands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "from_nm": {
                "type": "number",
                "minimum": 10,
                "maximum": 1000
              },
              "to_nm": {
                "type": "number",
                "minimum": 10,
                "maximum": 1000
              },
              "quiet_w_m2": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 1000
              },
              "variability": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "description": "Relative change from the quiet Sun to the reference maximum."
              }
            },
            "required": [
              "key",
              "from_nm",
              "to_nm",
              "quiet_w_m2",
              "variability"
            ]
          },
          "minItems": 1,
          "maxItems": 12,
          "description": "Default: Lyman-alpha, 200-242 nm, UV-C, UV-B, UV-A (keys uv_c, uv_b and uv_a tile 100-400 nm for the UV share of the TSI change)."
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ozone_change_at_reference": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "default": 0.02
        },
        "stratosphere_warming_at_reference_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 1.0
        },
        "erythemal_variability": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2,
          "default": 0.01
        },
        "radiation_amplification_factor": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2.5,
          "default": 1.23
        }
      }
    },
    "uv_sites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "latitude_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "ozone_du": {
            "type": "number",
            "minimum": 100,
            "maximum": 600,
            "description": "Annual-mean total ozone."
          },
          "ozone_seasonal_amplitude_du": {
            "type": "number",
            "minimum": 0,
            "maximum": 200,
            "default": 0
          },
          "ozone_peak_day": {
            "type": "number",
            "minimum": 0,
            "maximum": 366,
            "default": 90
          }
        },
        "required": [
          "name",
          "latitude_deg",
          "ozone_du"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "flares": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_rate_per_year": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 15
        },
        "reference_sunspot_number": {
          "type": "number",
          "minimum": 10,
          "maximum": 400,
          "default": 100
        },
        "rate_exponent": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3,
          "default": 1.3
        },
        "size_index": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 3,
          "default": 2.2
        },
        "max_peak_flux_w_m2": {
          "type": "number",
          "minimum": 0.003,
          "maximum": 1,
          "default": 0.004,
          "description": "Upper cut-off of the flare size distribution (W/m2; 4e-3 = X40, about the largest flares known)."
        },
        "energy_x1_j": {
          "type": "number",
          "minimum": 1e+20,
          "maximum": 1e+28,
          "default": 1e+25
        },
        "energy_exponent": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.8
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "climate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "albedo": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9,
          "default": 0.29
        },
        "upper_heat_capacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1000,
          "default": 7.3,
          "description": "W yr m-2 K-1"
        },
        "deep_heat_capacity": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000,
          "default": 106
        },
        "feedback_w_m2_k": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1.13
        },
        "exchange_w_m2_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "default": 0.74
        }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_year": {
          "type": "number"
        },
        "last_year": {
          "type": "number"
        },
        "every_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120,
          "default": 6
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256,
          "default": 56
        },
        "extent_radii": {
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "default": 1.08
        },
        "subsamples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 6
        },
        "effective_temperature_k": {
          "type": "number",
          "minimum": 3000,
          "maximum": 10000,
          "default": 5772
        },
        "limb_darkening": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.6
        },
        "groups_per_sunspot": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.058823529411764705
        },
        "group_area_median_uhem": {
          "type": "number",
          "minimum": 1,
          "maximum": 5000,
          "default": 100
        },
        "group_area_log_sd": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "default": 1.0
        },
        "umbra_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        },
        "umbra_contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "penumbra_contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.78
        },
        "facular_area_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 23
        },
        "facular_contrast_centre": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.005
        },
        "facular_contrast_limb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.12
        },
        "onset_latitude_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "default": 28
        },
        "drift_efold_months": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000,
          "default": 90
        },
        "zone_width_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "zone_min_width_deg": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "default": 3
        },
        "max_longitude_deg": {
          "type": "number",
          "minimum": 1,
          "maximum": 90,
          "default": 85
        },
        "area_per_sunspot_uhem": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "default": 10
        }
      },
      "required": [
        "first_year",
        "last_year"
      ],
      "description": "Frames of the rendered disk between first_year and last_year (within the record and the forecast), at most 240."
    },
    "butterfly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "type": "number"
        },
        "step_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 3
        },
        "latitude_step_deg": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 10,
          "default": 2.5
        },
        "max_latitude_deg": {
          "type": "number",
          "minimum": 10,
          "maximum": 90,
          "default": 45
        }
      }
    }
  }
}
