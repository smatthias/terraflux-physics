                "minItems": 1,
                "description": "Local aerosol warming (negative) of the central scenario."
              },
              "overturning_k": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1,
                "description": "Local cooling from a weaker Atlantic overturning (central scenario)."
              }
