{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.example/schemas/weather/ocean-run-v1.json",
  "title": "TerraFlux ocean circulation run request v1 (input of terraflux-run-ocean-circulation)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sponge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "south_rows": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "north_rows": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "time_scale_s": {
          "type": "number",
          "description": "Ignored here; see physics.sponge_time_scale_s.",
          "exclusiveMinimum": 0
        }
      },
      "description": "Relaxation strength ramps linearly from 1 at the wall to 0 over the given rows."
    }
  },
  "required": [
    "schema_version",
    "time",
    "grid",
    "basin",
    "forcing"
  ],
  "properties": {
    "schema_version": {
      "const": "terraflux.ocean.circulation-run/v1"
    },
    "time": {
      "type": "object",
      "required": [
        "start_time_utc",
        "timestep_seconds",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "start_time_utc": {
          "type": "string",
          "pattern": "Z$"
        },
        "timestep_seconds": {
          "type": "number",
          "description": "Must satisfy the gravity-wave CFL bound, f dt <= 0.5, r dt <= 1 and the explicit viscous bound.",
          "exclusiveMinimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "spinup_steps": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Unrecorded steps; the gyres need the Rossby-wave crossing time (years) to establish."
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "nx",
        "ny",
        "origin_east_m",
        "origin_north_m",
        "spacing_east_m",
        "spacing_north_m",
        "geographic_anchor_longitude_deg",
        "geographic_anchor_latitude_deg"
      ],
      "properties": {
        "nx": {
          "type": "integer",
          "minimum": 2
        },
        "ny": {
          "type": "integer",
          "minimum": 2
        },
        "origin_east_m": {
          "type": "number"
        },
        "origin_north_m": {
          "type": "number"
        },
        "spacing_east_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "spacing_north_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "geographic_anchor_longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "geographic_anchor_latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "coordinate_system": {
          "const": "local_azimuthal_equidistant_m"
        },
        "array_order": {
          "const": "row_major_y_then_x"
        }
      }
    },
    "basin": {
      "description": "Water where the terrain lies at or below sea level, or an explicit mask; optional sponge rows as an open-boundary proxy.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "ocean_mask"
          ],
          "properties": {
            "ocean_mask": {
              "type": "array",
              "items": {
                "enum": [
                  0,
                  1
                ]
              }
            },
            "sponge": {
              "$ref": "#/$defs/sponge"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "terrain"
          ],
          "additionalProperties": false,
          "properties": {
            "terrain": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "values"
                  ],
                  "properties": {
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "base_elevation_m": {
                      "type": "number",
                      "default": -4000
                    },
                    "slope_east_m_per_m": {
                      "type": "number",
                      "default": 0
                    },
                    "slope_north_m_per_m": {
                      "type": "number",
                      "default": 0
                    },
                    "ridges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "orientation_deg",
                          "center_east_m",
                          "center_north_m",
                          "height_m",
                          "half_width_m",
                          "length_m"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "orientation_deg": {
                            "type": "number"
                          },
                          "center_east_m": {
                            "type": "number"
                          },
                          "center_north_m": {
                            "type": "number"
                          },
                          "height_m": {
                            "type": "number",
                            "description": "Tall ridges above sea level are continents; negative heights carve trenches."
                          },
                          "half_width_m": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "length_m": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      }
                    },
                    "basins": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "center_east_m",
                          "center_north_m",
                          "depth_m",
                          "radius_m"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "center_east_m": {
                            "type": "number"
                          },
                          "center_north_m": {
                            "type": "number"
                          },
                          "depth_m": {
                            "type": "number"
                          },
                          "radius_m": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      }
                    },
                    "roughness_m": {
                      "type": "number",
                      "minimum": 0,
                      "default": 0
                    },
                    "roughness_seed": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 1
                    }
                  }
                }
              ]
            },
            "sea_level_m": {
              "type": "number",
              "default": 0
            },
            "sponge": {
              "$ref": "#/$defs/sponge"
            }
          }
        }
      ]
    },
    "ocean": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial_thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 500
        },
        "initial_salinity_psu": {
          "type": "number",
          "minimum": 0,
          "maximum": 45,
          "default": 35
        },
        "initial_temperature_k": {
          "type": "number",
          "minimum": 270,
          "maximum": 310,
          "default": 291.15
        }
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1025
        },
        "gravity_m_s2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 9.81
        },
        "thermal_expansion_per_k": {
          "type": "number",
          "minimum": 0,
          "default": 0.0002
        },
        "haline_contraction_per_psu": {
          "type": "number",
          "minimum": 0,
          "default": 0.00076
        },
        "reference_temperature_k": {
          "type": "number",
          "default": 283.15
        },
        "reference_salinity_psu": {
          "type": "number",
          "minimum": 0,
          "maximum": 45,
          "default": 35
        },
        "deep_temperature_k": {
          "type": "number",
          "minimum": 270,
          "maximum": 310,
          "default": 277.15
        },
        "deep_salinity_psu": {
          "type": "number",
          "minimum": 0,
          "maximum": 45,
          "default": 34.9
        },
        "minimum_reduced_gravity_m_s2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.001
        },
        "linear_friction_s": {
          "type": "number",
          "description": "Rayleigh drag r; the Stommel boundary-layer width is r / beta.",
          "minimum": 0,
          "default": 1e-06
        },
        "lateral_viscosity_m2_s": {
          "type": "number",
          "minimum": 0,
          "default": 500
        },
        "tracer_diffusivity_m2_s": {
          "type": "number",
          "minimum": 0,
          "default": 500
        },
        "minimum_thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 20
        },
        "temperature_relaxation_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2592000
        },
        "formation_reduced_gravity_m_s2": {
          "type": "number",
          "description": "Surface water with g' below this sinks (deep-water formation).",
          "minimum": 0,
          "default": 0.004
        },
        "convection_time_scale_s": {
          "type": "number",
          "description": "Sinking rate = (h - h_min) / tau_conv.",
          "exclusiveMinimum": 0,
          "default": 864000
        },
        "sponge_time_scale_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 432000
        },
        "upwelling_in_sponge": {
          "type": "boolean",
          "default": true
        },
        "mixed_layer_depth_m": {
          "type": "number",
          "description": "Surface layer holding the freshwater content; surface salinity = S (1 - F / h_mix).",
          "exclusiveMinimum": 0,
          "default": 50
        },
        "freshwater_mixing_time_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 2592000
        },
        "coriolis_mode": {
          "enum": [
            "none",
            "f_plane",
            "beta_plane",
            "prescribed"
          ],
          "default": "beta_plane"
        },
        "coriolis_parameter_s": {
          "type": "number",
          "minimum": -0.0002,
          "maximum": 0.0002,
          "default": 0
        },
        "stream_speed_threshold_m_s": {
          "type": "number",
          "description": "Connected cells faster than this (2 or more) are streams.",
          "exclusiveMinimum": 0,
          "default": 0.15
        },
        "plume_salinity_deficit_psu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5
        },
        "front_gradient_psu_per_100km": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 0.5
        }
      }
    },
    "forcing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wind": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "gyre"
                },
                "stress_amplitude_pa": {
                  "type": "number",
                  "minimum": -2,
                  "maximum": 2,
                  "default": 0.1
                },
                "gyres": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "default": 2
                },
                "wall_taper_m": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                },
                "south_margin_m": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                },
                "air_density_kg_m3": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2,
                  "default": 1.2
                },
                "drag_coefficient": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.01,
                  "default": 0.0013
                }
              },
              "description": "tau_x = -tau_0 cos(gyres pi y'/L') with y' measured from south_margin_m; one gyre = subtropical only, two = subtropical + subpolar."
            },
            {
              "type": "object",
              "required": [
                "kind",
                "stress_east_pa",
                "stress_north_pa"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "uniform"
                },
                "stress_east_pa": {
                  "type": "number",
                  "minimum": -10,
                  "maximum": 10
                },
                "stress_north_pa": {
                  "type": "number",
                  "minimum": -10,
                  "maximum": 10
                },
                "air_density_kg_m3": {
                  "type": "number"
                },
                "drag_coefficient": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "coupled_timeline"
                },
                "path": {
                  "type": "string"
                },
                "offset_seconds": {
                  "type": "number",
                  "default": 0
                },
                "air_density_kg_m3": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2,
                  "default": 1.2
                },
                "drag_coefficient": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 0.01,
                  "default": 0.0013
                }
              },
              "description": "Wind stress rho_air C_d |U| U and the surface temperature target from a coupled-wind timeline sampled at the nearest cell."
            }
          ]
        },
        "surface_temperature": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "south_k": {
              "type": "number",
              "minimum": 260,
              "maximum": 320,
              "default": 295.15
            },
            "north_k": {
              "type": "number",
              "minimum": 260,
              "maximum": 320,
              "default": 278.15
            },
            "cold_patches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "east_m",
                  "north_m",
                  "radius_m",
                  "temperature_k"
                ],
                "additionalProperties": false,
                "properties": {
                  "east_m": {
                    "type": "number"
                  },
                  "north_m": {
                    "type": "number"
                  },
                  "radius_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "temperature_k": {
                    "type": "number",
                    "minimum": 260,
                    "maximum": 320
                  }
                }
              },
              "description": "Gaussian cold (or warm) patches blended into the linear profile: deep-water formation sites."
            }
          }
        },
        "net_precipitation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "south_m_s": {
              "type": "number",
              "minimum": -1e-05,
              "maximum": 1e-05,
              "default": -1e-08
            },
            "north_m_s": {
              "type": "number",
              "minimum": -1e-05,
              "maximum": 1e-05,
              "default": 1e-08
            }
          },
          "description": "P - E, linear in north; negative = net evaporation (salt stays, water leaves)."
        },
        "rivers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "east_m",
              "north_m"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "east_m": {
                "type": "number",
                "description": "The mouth is the nearest water cell."
              },
              "north_m": {
                "type": "number"
              },
              "discharge_m3_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000.0,
                "default": 0
              },
              "temperature_k": {
                "type": "number",
                "minimum": 270,
                "maximum": 310,
                "default": 283.15
              },
              "salinity_psu": {
                "type": "number",
                "minimum": 0,
                "maximum": 45,
                "default": 0
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "start_seconds",
                    "duration_seconds",
                    "discharge_m3_s"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "start_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration_seconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "discharge_m3_s": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10000000.0
                    }
                  }
                },
                "description": "Additional discharge during the events (meltwater pulses, floods)."
              },
              "catchment_timeline_path": {
                "type": "string",
                "description": "A catchment hydrology timeline; its ocean + edge outflow rate between frames, times catchment_scale, is added to the discharge (piecewise constant, held after the last frame)."
              },
              "catchment_scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000.0,
                "default": 1
              }
            }
          }
        }
      }
    },
    "snapshot_every_steps": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    }
  }
}
