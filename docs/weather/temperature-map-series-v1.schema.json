{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerraFlux temperature map series v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "maps"],
  "properties": {
    "schema_version": {
      "const": "terraflux.weather.temperature-map-series/v1"
    },
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sidecar_file", "raster_file"],
        "properties": {
          "sidecar_file": {"type": "string", "minLength": 1},
          "raster_file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
