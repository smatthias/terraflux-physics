{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.example/schemas/weather-observation-v1.json",
  "title": "TerraFlux weather observation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "valid_time_utc", "variable", "value", "units", "location", "vertical_reference", "quality"],
  "properties": {
    "schema_version": { "const": "terraflux.weather.observation/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_kind", "interpretation"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["synthetic_fixture", "licensed_feed", "public_dataset", "user_supplied"] },
        "product_id": { "type": "string" },
        "interpretation": { "enum": ["palette_lookup", "structured_grid_value", "direct_measurement", "contour_interpolation", "manual_annotation", "derived_empirical_conversion", "derived_temporal_integration"] },
        "derivation": { "type": "string" },
        "sidecar": { "type": "string" }
      }
    },
    "valid_time_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "period_start_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Start of the accumulation interval; valid_time_utc is the interval end."
    },
    "variable": { "type": "string", "minLength": 1 },
    "value": { "type": ["number", "null"] },
    "units": { "type": "string", "minLength": 1 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "coordinates"],
      "properties": {
        "crs": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "vertical_reference": { "type": "string", "minLength": 1 },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["decoded", "no_data", "ambiguous"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "quality": { "properties": { "status": { "const": "decoded" } } } } },
      "then": {
        "properties": { "value": { "type": "number" } },
        "required": ["value"]
      }
    },
    {
      "if": { "properties": { "quality": { "properties": { "status": { "enum": ["no_data", "ambiguous"] } } } } },
      "then": {
        "properties": { "value": { "type": "null" } },
        "required": ["value"]
      }
    },
    {
      "if": { "properties": { "quality": { "properties": { "status": { "const": "ambiguous" } } } } },
      "then": { "properties": { "quality": { "required": ["reason"] } } }
    }
  ]
}
