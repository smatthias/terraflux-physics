{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraflux.example/schemas/earth-climate-run-v1.schema.json",
  "title": "TerraFlux coupled climate (drivers, impacts, CO2) run request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "history",
    "scenarios",
    "map",
    "co2_map"
  ],
  "properties": {
    "schema_version": {
      "const": "terraflux.earth.climate-run/v1"
    },
    "years": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1750,
          "maximum": 2000
        },
        "last": {
          "type": "integer",
          "minimum": 2030,
          "maximum": 2300
        },
        "today": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2030
        },
        "reference_first": {
          "type": "integer",
          "minimum": 1750,
          "maximum": 2000
        },
        "reference_last": {
          "type": "integer",
          "minimum": 1750,
          "maximum": 2000
        },
        "frame_every": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "note": {
          "type": "string"
        }
      },
      "description": "first <= reference_first <= reference_last < today (2020 or later) < last; at most 120 frames."
    },
    "climate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upper_heat_capacity": {
          "type": "number",
          "minimum": 1,
          "maximum": 50,
          "description": "W yr m-2 K-1"
        },
        "deep_heat_capacity": {
          "type": "number",
          "minimum": 10,
          "maximum": 1000
        },
        "exchange_w_m2_k": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "doubling_forcing_w_m2": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        },
        "feedbacks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planck": {
              "type": "number",
              "minimum": 1,
              "maximum": 6
            },
            "water_vapour_lapse_rate": {
              "type": "number",
              "minimum": -1,
              "maximum": 3
            },
            "surface_albedo": {
              "type": "number",
              "minimum": -1,
              "maximum": 2
            },
            "clouds": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "other": {
              "type": "number",
              "minimum": -2,
              "maximum": 2
            },
            "note": {
              "type": "string"
            }
          },
          "description": "Planck restoring, the others amplifying (W m-2 K-1); the net must stay at least 0.2."
        },
        "ecs_low_k": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "ecs_high_k": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "note": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "co2_ppm": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 150-3000; linear in between, constant beyond the ends."
        },
        "ch4_ppb": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 300-10000; linear in between, constant beyond the ends."
        },
        "n2o_ppb": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 150-1000; linear in between, constant beyond the ends."
        },
        "halocarbon_w_m2": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 0-3; linear in between, constant beyond the ends."
        },
        "ozone_index": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 0-5; linear in between, constant beyond the ends."
        },
        "aerosol_index": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 0-5; linear in between, constant beyond the ends."
        },
        "land_use_index": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 0-5; linear in between, constant beyond the ends."
        },
        "aviation_index": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1,
          "maxItems": 200,
          "description": "[year, value] points within 0-10; linear in between, constant beyond the ends."
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "co2_ppm",
        "ch4_ppb",
        "n2o_ppb",
        "halocarbon_w_m2",
        "ozone_index",
        "aerosol_index",
        "land_use_index",
        "aviation_index"
